# Salin nilai ini ke functions/.env.<projectId> atau set lewat Firebase.
# Jangan commit file .env yang berisi nilai asli.

# true untuk produksi Midtrans, false untuk sandbox.
MIDTRANS_IS_PRODUCTION=false

# Halaman yang dibuka setelah pembayaran selesai di browser.
PAYMENT_FINISH_URL=https://jeneponto-kurir.web.app/payment/finish

# MIDTRANS_SERVER_KEY TIDAK disimpan di file ini.
# Gunakan: firebase functions:secrets:set MIDTRANS_SERVER_KEY
